{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": ".config/fastfetch/.asciart1.txt",
    "padding": {
      "right": 4
     },
 "color": {
      "1": "#a19c08", // Changes primary color of the ASCII art
      "2": "blue"     // Changes secondary color (if the art uses multiple color codes)
    }
  },
  "display": {
    "color": {
      "output": "#258a07",
	"keys": "#a19c08",
        "title": "#a19c08"
    },

    "separator": "   "
  },
  "modules": [
    "title",
    {
      "type": "os",
      "key": "os"
    },
    {
      "type": "host",
      "key": "host",
      "format": "{2}"
    },
    {
      "type": "kernel",
      "key": "kernel"
    },
    {
      "type": "uptime",
      "key": "uptime"
    },
    {
      "type": "packages",
      "key": "pkgs"
    },
    {
      "type": "memory",
      "key": "memory",
      "format": "{1}/{2} ({3})"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}

