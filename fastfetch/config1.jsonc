{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": ".config/fastfetch/.asciart1.txt",
    "padding": {
      "right": 4
    }
  },
  "display": {
    "separator": "   "
  },
  "modules": [
    "title",
    {
      "type": "os",
      "key": "os"
    },
    {
      "type": "host",
      "key": "host",
      "format": "{2}"
    },
    {
      "type": "kernel",
      "key": "kernel"
    },
    {
      "type": "uptime",
      "key": "uptime"
    },
    {
      "type": "packages",
      "key": "pkgs"
    },
    {
      "type": "memory",
      "key": "memory",
      "format": "{}"
    },
"break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
